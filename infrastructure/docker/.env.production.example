# Copy this file to .env.production and replace every REPLACE_* value.
# Generate independent secrets, for example with: openssl rand -hex 32
APP_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_64_CHARACTER_RANDOM_VALUE

POSTGRES_DB=all_saints
POSTGRES_USER=saints_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

PUBLIC_PORT=80
ADMIN_PORT=8080
# These origins are compiled into the browser bundles during image builds.
PUBLIC_WEB_ORIGIN=https://encyklopedia.example
PUBLIC_ADMIN_ORIGIN=https://admin.encyklopedia.example
CORS_ORIGINS=https://encyklopedia.example,https://admin.encyklopedia.example
ALLOWED_HOSTS=encyklopedia.example,admin.encyklopedia.example,localhost,127.0.0.1
SECURE_COOKIES=true

STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=

AI_PROVIDER=none
OPENAI_API_KEY=
OLLAMA_BASE_URL=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
