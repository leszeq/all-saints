# ==============================================================================
# APPLICATION
# ==============================================================================
APP_NAME=all-saints
APP_ENV=development
APP_VERSION=1.0.0
APP_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_64_CHAR_STRING
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG

# ==============================================================================
# BACKEND
# ==============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================================================
# DATABASE – PostgreSQL
# ==============================================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=all_saints
POSTGRES_USER=saints_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DATABASE_URL=postgresql+asyncpg://saints_user:CHANGE_THIS_SECURE_PASSWORD@db:5432/all_saints
DATABASE_URL_SYNC=postgresql://saints_user:CHANGE_THIS_SECURE_PASSWORD@db:5432/all_saints
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Cache TTL (seconds)
CACHE_TTL_DEFAULT=300
CACHE_TTL_PERSONS=600
CACHE_TTL_STATIC=3600

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# STORAGE (MinIO / S3-compatible)
# ==============================================================================
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_PASSWORD
MINIO_BUCKET_IMAGES=saints-images
MINIO_BUCKET_DOCUMENTS=saints-documents
MINIO_BUCKET_EXPORTS=saints-exports
MINIO_USE_SSL=false

# AWS S3 (production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# AWS_S3_BUCKET=all-saints-prod

# ==============================================================================
# EMAIL (SMTP)
# ==============================================================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@all-saints.local
SMTP_TLS=false
SMTP_SSL=false

# ==============================================================================
# AI / EMBEDDINGS
# ==============================================================================
# Options: openai | ollama | none
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_COMPLETION_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# FRONTEND
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_MAPS_API_KEY=

# ==============================================================================
# MONITORING
# ==============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# Flower (Celery monitoring)
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:CHANGE_THIS_FLOWER_PASSWORD

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_PUBLIC=100/minute
RATE_LIMIT_AUTHENTICATED=1000/minute
RATE_LIMIT_ADMIN=5000/minute

# ==============================================================================
# SECURITY
# ==============================================================================
BCRYPT_ROUNDS=12
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================================================
# INITIAL ADMIN (used only for first seed)
# ==============================================================================
INITIAL_ADMIN_EMAIL=admin@all-saints.local
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
INITIAL_ADMIN_FULL_NAME=System Administrator
